{
  "name": "execution-worker",
  "sourceRoot": "apps/execution-worker/src",
  "projectType": "application",
  "tags": ["scope:execution-worker", "type:app", "platform:backend"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/execution-worker",
        "main": "apps/execution-worker/src/handler.ts",
        "tsConfig": "apps/execution-worker/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware src/",
        "cwd": "apps/execution-worker"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "options": {
        "command": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-lambda/handler.js",
        "cwd": "apps/execution-worker"
      }
    }
  }
}
