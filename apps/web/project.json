{
  "name": "web",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": ["scope:web", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/web"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev -p 4200",
        "cwd": "apps/web"
      }
    },
    "preview": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "next start",
        "cwd": "apps/web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint",
        "cwd": "apps/web"
      }
    },
    "serve-staging": {
      "executor": "nx:run-commands",
      "options": {
        "command": "(sleep 2 && open http://localhost:4200) & set -a && . ./.env.staging && set +a && next dev -p 4200",
        "cwd": "apps/web"
      }
    },
    "build-staging": {
      "executor": "nx:run-commands",
      "options": {
        "command": "set -a && . ./.env.staging && set +a && next build",
        "cwd": "apps/web"
      }
    }
  }
}
