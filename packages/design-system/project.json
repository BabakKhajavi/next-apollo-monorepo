{
  "name": "design-system",
  "sourceRoot": "packages/design-system/src",
  "projectType": "library",
  "tags": ["scope:design-system", "type:ui"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/design-system",
        "main": "packages/design-system/src/index.ts",
        "tsConfig": "packages/design-system/tsconfig.json"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 6006 --config-dir .storybook",
        "cwd": "packages/design-system"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/../../dist/storybook/design-system"],
      "options": {
        "command": "storybook build --config-dir .storybook --output-dir ../../dist/storybook/design-system",
        "cwd": "packages/design-system"
      }
    }
  }
}
